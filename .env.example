# Backend FastAPI yang sama dengan web (tanpa /api di akhir)
EXPO_PUBLIC_API_URL=https://talita.statapps.dev
# Socket.IO (default: sama dengan API_URL, path /socket.io)
EXPO_PUBLIC_SOCKET_URL=https://talita.statapps.dev
EXPO_PUBLIC_SOCKET_PATH=/socket.io
# Google OAuth client ID (Google Cloud Console > Credentials)
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
